{
  "formatVersion": 1,
  "version": "2.5.0",
  "label": "睡前消息新闻知识本体",
  "description": "作为新闻知识抽取的蓝图，分别定义实体类、事件行动与议题层级；抽取后的知识图谱是独立的版本化结果。",
  "recordUnit": {
    "id": "news",
    "label": "独立新闻",
    "description": "一个具有独立主题、可精确追溯到原始页面片段的新闻记录；原始 Markdown 页面只是来源容器。"
  },
  "facets": [
    {
      "id": "event",
      "label": "报道领域",
      "description": "兼容旧版新闻领域分类，不代表具体事件行动",
      "eventTypes": [
        "*"
      ]
    },
    {
      "id": "subject",
      "label": "主体",
      "description": "事件中的人物与组织",
      "entityTypes": [
        "person",
        "organization"
      ]
    },
    {
      "id": "place",
      "label": "地点",
      "description": "事件涉及的国家、地区与城市",
      "entityTypes": [
        "place"
      ]
    },
    {
      "id": "topic",
      "label": "主题",
      "description": "跨事件复用的受控议题",
      "entityTypes": [
        "topic"
      ]
    },
    {
      "id": "named_object",
      "label": "对象",
      "description": "事件涉及的设施、政策文件与命名报告",
      "entityTypes": [
        "facility",
        "policy",
        "document"
      ]
    }
  ],
  "eventEntityConstraint": {
    "minimumEntities": 1,
    "description": "每条事件至少通过一个语义角色关联一个实体；并非要求每个可选 facet 都必须出现。"
  },
  "eventEntityRoles": [
    {
      "id": "subject",
      "label": "主体",
      "description": "参与事件、受事件影响或作为报道核心的人物与组织。",
      "entityTypes": [
        "person",
        "organization"
      ]
    },
    {
      "id": "place",
      "label": "地点",
      "description": "事件明确涉及的国家、地区、城市或其他地理区域。",
      "entityTypes": [
        "place"
      ]
    },
    {
      "id": "topic",
      "label": "主题",
      "description": "用于跨时期聚合事件的受控议题。",
      "entityTypes": [
        "topic"
      ]
    },
    {
      "id": "named_object",
      "label": "命名对象",
      "description": "事件明确涉及的设施、政策文件、报告或文献。",
      "entityTypes": [
        "facility",
        "policy",
        "document"
      ]
    }
  ],
  "relationTypes": [
    {
      "id": "precedes",
      "label": "先于",
      "description": "两个新闻投影涉及同一非泛化实体，按报道发布日期排序；不推断现实事件的发生顺序或因果。",
      "from": [
        "event"
      ],
      "to": [
        "event"
      ],
      "directed": true
    },
    {
      "id": "located_in",
      "label": "位于",
      "description": "设施或组织位于某个地理区域；仅在原文存在明确定位证据时使用。",
      "from": [
        "facility",
        "organization"
      ],
      "to": [
        "place"
      ],
      "directed": true
    },
    {
      "id": "part_of",
      "label": "属于",
      "description": "一个设施、组织或政策文件是另一个命名对象的组成部分。",
      "from": [
        "facility",
        "organization",
        "policy"
      ],
      "to": [
        "facility",
        "organization",
        "policy"
      ],
      "directed": true
    }
  ],
