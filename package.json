{
  "name": "bedtimenews-kg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "ontology:compile": "node scripts/compile-ontology.mjs",
    "ontology:check": "node scripts/compile-ontology.mjs --check",
    "prebuild": "npm run ontology:check",
    "prebuild:pages": "npm run ontology:check",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "NEXT_OUTPUT_EXPORT=1 next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "news:build": "node scripts/build-news.mjs",
    "kg:build": "node scripts/build-kg.mjs",
    "kg:bootstrap": "node scripts/update-kg.mjs --bootstrap",
    "kg:rebuild": "node scripts/update-kg.mjs --rebuild",
    "kg:update": "node scripts/update-kg.mjs",
    "kg:validate": "node scripts/validate-kg.mjs",
    "test:required": "node --test --test-skip-pattern='^required semantic coverage is 100%$' tests/*.test.mjs",
    "test:coverage": "node --test --test-name-pattern='^required semantic coverage is 100%$' tests/data.test.mjs",
    "test": "npm run kg:release:validate && node --test tests/*.test.mjs && npm run build && npm run build:pages",
    "test:pages": "npm run build:pages && node --test tests/data.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "kg:candidate": "node scripts/build-candidate.mjs",
    "kg:candidate:validate": "node scripts/validate-candidate.mjs",
    "kg:lifecycle": "node scripts/build-lifecycle-candidate.mjs",
    "kg:lifecycle:validate": "node scripts/validate-lifecycle-candidate.mjs",
    "kg:release:sync": "node scripts/sync-accepted-release.mjs",
    "kg:release:recover": "node scripts/sync-accepted-release.mjs --recover-only",
    "kg:release:validate": "node scripts/validate-accepted-release.mjs",
    "kg:release:rollback": "node scripts/sync-accepted-release.mjs --rollback",
    "kg:release:migration:preview": "node scripts/preview-accepted-migration.mjs",
    "kg:release:migration:prepare": "node scripts/prepare-migration-pr.mjs",
    "kg:release:validate-pr": "node scripts/validate-migration-pr.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "vinext": {
      "image-size": "2.0.3"
    }
  },
  "type": "module"
}
